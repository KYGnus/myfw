###############################################################################
# MAIN
###############################################################################

main() {

    require_root
    init_directories
    load_config
    acquire_lock

    local command="${1:-help}"

    case "$command" in

        start)
            firewall_start
            ;;

        stop)
            firewall_stop
            ;;

        restart)
            firewall_stop
            firewall_start
            ;;

        status)
            firewall_status
            ;;

        rules)
            firewall_rules
            ;;

        policy)

            case "${2:-}" in
                validate)
                    policy_validate
                    ;;
                apply)
                    apply_ruleset
                    ;;
                *)
                    show_help
                    ;;
            esac
            ;;

        rule)

            local action="${2:-}"
            shift 2 || true

            local port=""
            local proto=""
            local service=""
            local direction="input"

            while [ $# -gt 0 ]; do

                case "$1" in

                    --port)
                        port="$2"
                        shift 2
                        ;;

                    --proto|--protocol)
                        proto="$2"
                        shift 2
                        ;;

                    --service)
                        service="$2"
                        shift 2
                        ;;

                    --direction)
                        direction="$2"
                        shift 2
                        ;;

                    *)
                        die "Unknown rule option: $1"
                        ;;
                esac

            done

            if [ -n "$service" ]; then
                add_service_rule "$action" "$service" "$direction"
            else
                add_port_rule "$action" "$port" "$proto" "$direction"
            fi

            ;;

        block)

            case "${2:-}" in

                add)

                    ip="${3:-}"
                    timeout=""

                    if [ "${4:-}" = "--timeout" ]; then
                        timeout="${5:-}"
                    fi

                    block_ip "$ip" "$timeout"
                    ;;

                remove)
                    unblock_ip "${3:-}"
                    ;;

                list)
                    list_blocked
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        whitelist)

            case "${2:-}" in
                add)
                    whitelist_ip "${3:-}"
                    ;;
                *)
                    show_help
                    ;;
            esac

            ;;

        nat)

            case "${2:-}" in

                masquerade)
                    configure_nat "${3:-}" "${4:-}"
                    ;;

                dnat)
                    configure_dnat \
                        "${3:-}" \
                        "${4:-}" \
                        "${5:-}" \
                        "${6:-tcp}"
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        rate-limit)

            add_rate_limit \
                "${2:-}" \
                "${3:-}" \
                "${4:-}"

            ;;

        ids)

            case "${3:-}" in

                start)
                    suricata_start "${4:-}"
                    ;;

                stop)
                    suricata_stop
                    ;;

                status)
                    suricata_status
                    ;;

                update)
                    suricata_update
                    ;;

                ips-enable)
                    suricata_ips_enable
                    ;;

                logs)
                    suricata_log
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        ips)

            case "${3:-}" in

                start)
                    fail2ban_start
                    ;;

                stop)
                    fail2ban_stop
                    ;;

                status)
                    fail2ban_status
                    ;;

                bans)
                    fail2ban_ban_list
                    ;;

                unban)
                    fail2ban_unban "${4:-}"
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        panic)

            case "${2:-}" in
                enable)
                    panic_enable
                    ;;
                disable)
                    panic_disable
                    ;;
                *)
                    show_help
                    ;;
            esac

            ;;

        conntrack)

            case "${2:-}" in

                list)
                    conntrack_list
                    ;;

                count)
                    conntrack_count
                    ;;

                flush)
                    conntrack_flush
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        backup)

            case "${2:-}" in

                create)
                    backup_create
                    ;;

                list)
                    backup_list
                    ;;

                restore)
                    backup_restore "${3:-}"
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        ids-maltrail)

            case "${2:-}" in

                start)
                    maltrail_start
                    ;;

                stop)
                    maltrail_stop
                    ;;

                status)
                    maltrail_status
                    ;;

                *)
                    show_help
                    ;;
            esac

            ;;

        service)

            service_action \
                "${2:-}" \
                "${3:-}"

            ;;

        info)
            system_info
            ;;

        version)
            echo "${APP_NAME} ${VERSION}"
            ;;

        help|--help|-h)
            show_help
            ;;

        *)
            error "Unknown command: $command"
            show_help
            exit 1
            ;;

    esac
}

main "$@"