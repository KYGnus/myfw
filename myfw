###############################################################################

backup_create() {

    require_command nft

    local timestamp
    timestamp="$(date '+%Y%m%d-%H%M%S')"

    local file="${BACKUP_DIR}/myfw-${timestamp}.nft"

    nft list ruleset > "$file" ||
        die "Failed to create backup."

    chmod 600 "$file"

    audit "BACKUP_CREATE FILE=${file}"

    echo "Backup created:"
    echo "$file"
}

backup_list() {

    ls -lh "$BACKUP_DIR"/*.nft 2>/dev/null ||
        echo "No firewall backups found."
}

backup_restore() {

    local file="$1"

    [ -n "$file" ] ||
        die "Backup file required."

    [ -f "$file" ] ||
        die "Backup not found: $file"

    require_command nft

    info "Validating backup..."

    nft -c -f "$file" ||
        die "Backup failed validation."

    backup_current_ruleset || true

    info "Restoring nftables ruleset..."

    nft -f "$file" ||
        die "Firewall backup restore failed."

    audit "BACKUP_RESTORE FILE=${file}"

    log "Firewall backup restored."
}

