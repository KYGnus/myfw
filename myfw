firewall_stop() {

    require_command nft

    if nft_exists; then

        backup_current_ruleset || true

        nft delete table \
            "$NFT_FAMILY" \
            "$NFT_TABLE" ||
            die "Failed to stop myfw firewall."
    fi

    audit "FIREWALL_STOP"

    log "myfw firewall stopped."
}

firewall_restart() {

    #
    # Apply directly instead of:
    #
    #   stop -> start
    #
    # This minimizes the firewall gap.
    #

    apply_ruleset ||
        die "Firewall restart failed."

    audit "FIREWALL_RESTART"

    log "myfw firewall restarted."
}

